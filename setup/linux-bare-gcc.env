# The linux-bare toolchain's compiler: GCC built by this repository from the GNU release of the versions.env pin and
# published as its release asset (.github/workflows/gcc.yml), so that no runner depends on a third-party package
# source (the ubuntu-toolchain-r/test PPA on Launchpad: 503s for hours on 2026-11-17, and a 16.0.1 snapshot for a
# 16.2.0 pin).
#
# The source: setup/linux-bare.sh build checks the release's signature against GNU's keyring, then that the signer is
# this key (Richard Biener, GCC release manager) and the tarball this sha256 (verified 2026-11-17 from ftpmirror.gnu.org:
# "Good signature", made 2026-08-07). A new GCC pin needs these three lines anew.
GCC_SOURCE_VERSION=16.2.0
GCC_SOURCE_SIGNER=7F74F97C103468EE5D750B583AB00996FC26A641
GCC_SOURCE_SHA256=e6738e29597f733270731aa90600f37ffdc045079dfc27ec7e8192cc81085c3e

# The built toolchain: gcc.yml prints these three lines after it publishes it; until they are set, linux-bare fails
# (there is no other source). The environment variables of the same names override them.
LINUX_BARE_GCC_TAG=linux-bare-gcc-16.2.0-ubuntu24.04
LINUX_BARE_GCC_ASSET=gcc-16.2.0-ubuntu24.04-amd64.tar.xz
LINUX_BARE_GCC_SHA256=98d0e9c238b42d27efaeff8c583e20db42be55f48923dafd68d9a18800aa2ffb
