# The versions of every toolchain component, the single source the images are built from. Rule: each one is the
# latest installed on the WSL box. `scripts/wsl-versions.sh` checks this file against WSL (exit 1 on drift) and
# `scripts/wsl-versions.sh --write` rewrites it from WSL.

# GNU: gcc, the Open MPI built by it, HDF5 (ADAM's develop build; the commit cannot be read back from WSL)
GCC=16.2.0
OPENMPI=5.0.11
HDF5=2.3.0
HDF5_COMMIT=ab5df5526c96a03bf1d89cea59603b77a239eac0

# NVIDIA HPC SDK and the CUDA it bundles
NVHPC=26.9
CUDA=13.3

# Intel oneAPI: ifx and Intel MPI
IFX=2026.2.0
INTEL_MPI=2021.19

# Tools
NODE=24.13.0
FOBIS=3.16.9
FORD=7.0.13
FORMAL=0.2.16
FPM=0.13.0
CMAKE=4.4.4
NINJA=1.13.2
SHELLCHECK=0.9.0
ZSH=5.9
FISH=4.9.3
PWSH=7.7.0
